generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoTarefa {
  aberta
  em_progresso
  concluida
  cancelada
}

enum PrioridadeTarefa {
  baixa
  media
  alta
  critica
}

model Utilizador {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  tarefas  Tarefa[] // Relação 1-para-muitos
}

model Projecto {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  estado      String   @default("ativo")
  tarefas     Tarefa[] // Relação 1-para-muitos
}

model Tarefa {
  id            Int        @id @default(autoincrement())
  titulo        String
  estado        EstadoTarefa     @default("aberta")
  prioridade    PrioridadeTarefa     @default("media")
  
  // Relações com chaves estrangeiras
  id_projecto   Int
  projecto      Projecto   @relation(fields: [id_projecto], references: [id])
  
  id_utilizador Int?
  utilizador    Utilizador? @relation(fields: [id_utilizador], references: [id])
}